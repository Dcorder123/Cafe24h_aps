# ==============================================
# 🔧 CONFIGURAÇÕES DO CAFÉ 24H - AMBIENTE
# ==============================================

# 🗄️ Configurações do Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=cafe24h_db
DB_PORT=3306

# 🚀 Configurações do Servidor API
SERVER_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ⚛️ Configurações do Frontend React
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_APP_NAME=Café 24h
REACT_APP_VERSION=1.0.0

# 🔥 Firebase Configuration (Autenticação)
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# 💳 Configurações de Pagamento (PIX)
REACT_APP_PIX_KEY=sua_chave_pix_aqui
REACT_APP_PIX_MERCHANT=Café 24h

# 🌐 Configurações de Deploy
# Para produção (Netlify), mude estas URLs:
# REACT_APP_API_URL=https://sua-api-producao.herokuapp.com/api
# NODE_ENV=production

# 🔒 Chaves de Segurança
JWT_SECRET=sua_chave_jwt_super_secreta_aqui
ENCRYPTION_KEY=sua_chave_de_criptografia_aqui

# 📧 Configurações de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app

# 🏪 Configurações da Cafeteria
CAFE_NAME=Café 24h
CAFE_ADDRESS=Sua Endereço, 123 - Bairro, Cidade - UF
CAFE_PHONE=(11) 99999-9999
CAFE_EMAIL=contato@cafe24h.com
