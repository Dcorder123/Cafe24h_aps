{
  "name": "sistema-cafeteria",
  "version": "1.0.0",
  "description": "Sistema web completo para gerenciamento de cafeteria com React + Node.js",
  "keywords": [
    "react",
    "nodejs",
    "express",
    "mysql",
    "cafeteria",
    "sistema-pedidos"
  ],
  "author": "Equipe APS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dcorder123/Cafe24h_aps.git"
  },
  "bugs": {
    "url": "https://github.com/Dcorder123/Cafe24h_aps/issues"
  },
  "private": false,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "firebase": "^9.9.0",
    "mysql2": "^3.14.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "concurrently \"npm start\" \"cd backend && node server-complete.js\"",
    "build:netlify": "npm run build && echo 'Build concluído para Netlify!'",
    "start:backend": "cd backend && node server-complete.js",
    "install:all": "npm install && cd backend && npm install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
